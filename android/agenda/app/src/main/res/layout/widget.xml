<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
  <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Poliedra · Agenda" android:textSize="16sp" android:textStyle="bold" android:textColor="#102C46"/>
  <Button android:background="@drawable/button_bg" android:textColor="#006D67" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:minWidth="0dp" android:padding="2dp" android:id="@+id/prev" android:layout_width="48dp" android:layout_height="44dp" android:text="‹" android:contentDescription="Periodo precedente"/>
  <Button android:background="@drawable/button_bg" android:textColor="#006D67" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:minWidth="0dp" android:padding="2dp" android:id="@+id/today" android:layout_width="64dp" android:layout_height="44dp" android:text="Oggi" android:textSize="12sp"/>
  <Button android:background="@drawable/button_bg" android:textColor="#006D67" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:minWidth="0dp" android:padding="2dp" android:id="@+id/next" android:layout_width="48dp" android:layout_height="44dp" android:text="›" android:contentDescription="Periodo successivo"/>
 </LinearLayout>
 <TextView android:id="@+id/period" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#102C46" android:textStyle="bold"/>
 <LinearLayout android:id="@+id/week" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
<TextView android:id="@+id/day0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
<TextView android:id="@+id/day1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
<TextView android:id="@+id/day2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
<TextView android:id="@+id/day3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
<TextView android:id="@+id/day4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
<TextView android:id="@+id/day5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
<TextView android:id="@+id/day6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:textColor="#102C46"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
  <TextView android:id="@+id/filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Tutti · Studio + Personale" android:textSize="12sp" android:textColor="#006D67"/>
  <TextView android:id="@+id/privacy" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center" android:text="Dettagli" android:textSize="12sp" android:textColor="#006D67"/>
 </LinearLayout>
 <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="2dp"/>
 <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Apri l’app per aggiornare" android:textColor="#536779" android:textSize="14sp"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:textSize="11sp" android:textColor="#536779" android:maxLines="1" android:ellipsize="end"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <Button android:background="@drawable/button_bg" android:textColor="#006D67" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:minWidth="0dp" android:padding="2dp" android:id="@+id/add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="+ Impegno" android:textSize="12sp" android:contentDescription="Nuovo impegno personale nel giorno scelto"/>
  <Button android:background="@drawable/button_bg" android:textColor="#006D67" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:minWidth="0dp" android:padding="2dp" android:id="@+id/addStudio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="+ Appunt." android:textSize="12sp" android:contentDescription="Nuovo appuntamento dello studio nel giorno scelto"/>
  <Button android:background="@drawable/button_bg" android:textColor="#006D67" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:minWidth="0dp" android:padding="2dp" android:id="@+id/open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Agenda ↗" android:textSize="12sp" android:contentDescription="Apri l’agenda nel giorno scelto"/>
 </LinearLayout>
</LinearLayout>