{
  "rewrites": [
    {
      "source": "/oauth/consent",
      "destination": "/personal/index.html"
    },
    {
      "source": "/oauth/consent/",
      "destination": "/personal/index.html"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-metadata"
    },
    {
      "source": "/poliedron/personal",
      "destination": "/personal/index.html"
    },
    {
      "source": "/poliedron/personal/",
      "destination": "/personal/index.html"
    },
    {
      "source": "/poliedron/archivio",
      "destination": "/archivio/index.html"
    },
    {
      "source": "/poliedron/archivio/",
      "destination": "/archivio/index.html"
    },
    {
      "source": "/archivio",
      "destination": "/archivio/index.html"
    },
    {
      "source": "/archivio/",
      "destination": "/archivio/index.html"
    },
    {
      "source": "/personal",
      "destination": "/personal/index.html"
    },
    {
      "source": "/personal/",
      "destination": "/personal/index.html"
    },
    {
      "source": "/poliedron",
      "destination": "/poliedron/index.html"
    },
    {
      "source": "/poliedron/",
      "destination": "/poliedron/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/oauth/consent/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"},
        {"key": "Referrer-Policy", "value": "no-referrer"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/poliedron/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/poliedron.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/personal/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/archivio/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "personal.poliedrasoft.it"
        }
      ],
      "destination": "/personal/",
      "permanent": false
    }
  ]
}
