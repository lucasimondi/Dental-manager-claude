{
  "name": "Poliedron Personal",
  "short_name": "Personal",
  "description": "Archivio personale: documenti, portafoglio, scadenze e pratiche",
  "start_url": "/personal/",
  "scope": "/personal/",
  "display": "standalone",
  "background_color": "#f2f4f7",
  "theme_color": "#f2f4f7",
  "icons": [
    {
      "src": "/poliedron-v2-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/poliedron-v2-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "id": "https://personal.poliedrasoft.it/",
  "share_target": {
    "action": "/personal/?receive-pdf=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}
